# Auto detect text files and perform LF normalization
* text=auto

Jint.Tests/** linguist-vendored
Jint.Tests.Ecma/** linguist-vendored
Jint.Tests.CommonScripts/** linguist-vendored
Jint.Tests.Test262/** linguist-vendored

# Verify snapshot files must use LF line endings on all platforms.
# Verify (31.21.0+) rejects carriage returns in verified files, which otherwise
# break on Windows checkouts where autocrlf converts LF to CRLF.
# The vendored .asis files are whole HTTP responses, byte for byte as upstream stores them — LF line
# endings included. A Windows checkout that rewrote them would change what the driver puts on the wire, so
# they are not text as far as git is concerned; WptServer normalizes the framing when it serves one.
Jint.Tests/Wpt/Vendor/**/*.asis -text

*.verified.cs text eol=lf
*.verified.txt text eol=lf
*.received.cs text eol=lf
*.received.txt text eol=lf

# The Encoding Standard's data is vendored verbatim, so that verifying it against upstream is
# re-downloading it at the pinned commit and diffing. A Windows checkout must not rewrite its
# line endings, or every one of those diffs would be the whole file.
tools/whatwg-encoding/*.json text eol=lf
tools/whatwg-encoding/whatwg-encoding-LICENSE.txt text eol=lf

# The Test262 generated suite is cached across operating systems, keyed on a hash of this
# settings file. It must therefore be byte-identical on every platform: a CRLF Windows checkout
# would change the cache key (hashFiles) and the MSBuild regeneration gate, turning every
# cross-OS cache restore into a full regeneration.
Jint.Tests.Test262/Test262Harness.settings.json text eol=lf

# The vendored web-platform-tests corpus is copied verbatim from a pinned upstream commit and is meant to
# stay byte-identical to it, so that re-fetching at the same SHA produces no diff and the pin means what it
# says. Upstream is LF, so pin the working tree to LF too rather than letting autocrlf rewrite it.
Jint.Tests/Wpt/Vendor/** text eol=lf

# The Chrome DevTools Protocol description is copied verbatim from a pinned upstream commit and is meant
# to stay byte-identical to it, so that re-fetching at the same commit produces no diff and the pin means
# what it says. Upstream is LF, so pin the working tree to LF rather than letting autocrlf rewrite it.
tools/devtools-protocol/js_protocol.json text eol=lf
tools/devtools-protocol/browser_protocol.json text eol=lf
tools/devtools-protocol/devtools-protocol-LICENSE text eol=lf

# Ours rather than upstream's, in the same format and beside them: the Jint domain a page target answers.
# Pinned to LF for the same reason its neighbours are -- the generator reads all three alike, and a file that
# differed by line ending between checkouts would make the emitted output differ with it.
tools/devtools-protocol/jint_protocol.json text eol=lf

# Generated from the vendored protocol JSON and from AngleSharp's [DomName] attributes, checked in on purpose
# (a pin bump is a diff to read, and the serializer context has to be generated over the DTOs), and
# collapsed in pull-request review and excluded from language statistics for the same reason.
Jint.DevTools/Protocol/Generated/*.g.cs linguist-generated=true
Jint.Browser/Dom/Generated/*.g.cs linguist-generated=true

# The obstacle course's vendored half: each library's own published bundle and its licence, byte for byte, so
# that re-downloading at the pinned version produces no diff. Upstream publishes LF, so pin the working tree
# to LF rather than letting autocrlf rewrite it — the same arrangement the web-platform-tests corpus is under.
# linguist-vendored so the minified bundles do not count as this repository's source; the fixture pages and
# the C# beside them are ours and are deliberately not marked.
Jint.Tests.Browser/Fixtures/vendor/** linguist-vendored
Jint.Tests.Browser/Fixtures/vendor/** text eol=lf

# Svelte has no runtime a page can load, so this fixture's app is build output rather than a download. It
# carries Svelte's own runtime inlined, which is why it is vendored too.
Jint.Tests.Browser/Fixtures/todomvc-svelte/todomvc.bundle.js linguist-vendored

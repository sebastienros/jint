<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Acornima" Version="1.8.0" />
    <PackageVersion Include="Acornima.Extras" Version="1.8.0" />
    <!-- Comparison controls for Jint.HtmlParser only. Production, tests and binding generation use
         native models; historical binding provenance does not constrain these benchmark versions. -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <PackageVersion Include="AngleSharp.Css" Version="1.1.2" />
    <PackageVersion Include="AngleSharp.Xml" Version="1.2.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BenchmarkDotNet.TestAdapter" Version="0.15.8" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Flurl.Http.Signed" Version="4.0.2" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="ICU4N" Version="60.1.0-alpha.440" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.294" />
    <PackageVersion Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- The generic host the jint-browser `mcp` command builds its server on: the Model Context Protocol
         SDK's own documented hosting path, and the one whose stdout purity it guarantees. Only the tool
         references it; Jint.Browser.Mcp is transport-agnostic and takes the abstractions the SDK already
         brings. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!--
      The second automation client, and the version tools/devtools-protocol/handshakes/playwright-dotnet.json
      was recorded with, so what it sends in Jint.Tests.Browser is what that file says it sends. The package
      carries its own driver, node runtime included, so ConnectOverCDPAsync needs no `playwright install` and
      downloads no browser.
    -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- The official Model Context Protocol C# SDK, which Jint.Browser.Mcp is a server on. The metapackage
         brings ModelContextProtocol.Core plus the dependency-injection and hosting glue; the third package,
         ModelContextProtocol.AspNetCore, is deliberately NOT referenced anywhere — it carries a framework
         reference to Microsoft.AspNetCore.App, which a dotnet tool must not require to start. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="MongoDB.Bson.signed" Version="2.19.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NiL.JS" Version="2.6.1722" />
    <PackageVersion Include="NodaTime" Version="3.3.5" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Okojo" Version="0.1.2-preview.1" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="PuppeteerSharp" Version="25.12.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="SourceMaps" Version="0.3.0" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="Test262Harness" Version="1.2.1" />
    <PackageVersion Include="YantraJS.Core" Version="1.2.476" />
    <PackageVersion Include="Zio" Version="0.24.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiler-required attributes and marker types for the downlevel targets. This is not optional
         polish: without it `init`, `record`, `required` and the nullable/trimming attributes do not
         compile on net472/netstandard2.0. Global because the test projects need it too: the
         [ModuleInitializer] in Jint.Tests/HostContractVerificationSwitch.cs is what arms host-contract
         verification early enough on the net472 leg.

         Keep the SDK floor in global.json at 10.0.100 or later. PolySharp 1.16.0 emits its types with
         [Microsoft.CodeAnalysis.Embedded], which Roslyn only accepts from 4.14 onwards; on an older
         compiler it fails with CS8336, and Jint.SourceGenerators (netstandard2.0 + IsRoslynComponent
         + Microsoft.CodeAnalysis.CSharp) is exactly the shape that trips it. -->
    <GlobalPackageReference Include="PolySharp" Version="1.16.0" />
  </ItemGroup>
</Project>

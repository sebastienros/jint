<Project TreatAsLocalProperty="PackageVersion">
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyOriginatorKeyFile>..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <IsPackable>true</IsPackable>
    <PackageId>Jint.HtmlParser</PackageId>
    <Description>Native document tree infrastructure for Jint markup parsing</Description>
    <PackageTags>html,xml,svg,dom,jint</PackageTags>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Parsing/ValueStringBuilder.LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- ACC-06 remains open. Apply after SDK version calculation so pack and project-reference
       metadata agree, including command-line Version/PackageVersion and GA release tags.
       Removing this policy requires explicit external package/API acceptance. -->
  <PropertyGroup>
    <PackageVersion Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageVersion)', '^[0-9]+(\.[0-9]+){1,3}-'))">$([System.Text.RegularExpressions.Regex]::Replace('$(PackageVersion)', '^([^+]+)(.*)$', '$1-experimental-$(BuildNumber)$2'))</PackageVersion>
  </PropertyGroup>
</Project>

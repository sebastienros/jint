<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- The whole package is net8.0+, the same floor Jint/WebApi/ and Jint.DevTools sit on and for the same
         reason: this is host surface built on the modern BCL, not engine surface a netstandard consumer
         resolves. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <AssemblyOriginatorKeyFile>..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <IsPackable>true</IsPackable>
    <PackageId>Jint.Browser</PackageId>
    <Description>A headless browser powered by Jint and its native HTML and CSS model</Description>
    <PackageTags>javascript, interpreter, jint, dom, html, headless, browser</PackageTags>

    <Nullable>enable</Nullable>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- A GA Browser can intentionally consume the experimental parser until ACC-06 closes.
         Its project reference obtains the parser's independently calculated package version. -->
    <NoWarn>$(NoWarn);1591;NU5104</NoWarn>

    <!-- The closed browser tool's native publication does not establish a general trimming contract
         for every library embedding. Keep the existing package claim until the coordinated consumer
         verification establishes that contract. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package README NuGet shows. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../tools/bidi-data/LICENSE.txt" Pack="true" PackagePath="Unicode-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jint\Jint.csproj" />
    <ProjectReference Include="..\Jint.HtmlParser\Jint.HtmlParser.csproj" />
    <!--
      The page-level protocol domains derive from the generated dispatch bases in Jint.DevTools, and a page
      target is one of its targets. The dependency is one way and stays that way: Jint.DevTools works for a
      host with no pages at all, and nothing in it knows what a document is.
    -->
    <ProjectReference Include="..\Jint.DevTools\Jint.DevTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AST does not reach this assembly at all, so the repository-wide Acornima global usings would be
         noise; the same call Jint.DevTools makes. -->
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The package's own two target frameworks. There is no net472 leg because there is no net472 asset:
         Jint.DevTools is net8.0+, like Jint/WebApi/. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <!-- Signed with the repository key, because Jint.DevTools is signed and names this assembly as a
         friend. Everything the protocol server has is internal, so without the grant there is nothing here
         to test. -->
    <AssemblyOriginatorKeyFile>..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jint.DevTools\Jint.DevTools.csproj" />
    <!--
      The emitter, referenced as a library so GeneratedProtocolIsCurrentTests can run it in memory against
      the vendored JSON and diff its output with what is checked in. That is the whole reason the generator
      targets net8.0 rather than net10.0: this suite runs on both legs, and a net10.0-only emitter would be
      unreferenceable from the lower one.
    -->
    <ProjectReference Include="..\tools\devtools-protocol\Jint.DevTools.ProtocolGenerator\Jint.DevTools.ProtocolGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!--
    The public API baseline runs on one leg, the way Jint.Tests.PublicInterface's does and for the same
    reasons: which runtime reads a file on disk changes nothing, and a second leg is a second process
    reading artifacts/ while the first leg's build is still writing it.

    Unlike Jint's, there is ONE baseline rather than one per target framework, because Jint.DevTools has no
    conditional compilation at all: its two assets are compiled from the same sources, so their surfaces
    cannot differ. NoSourceFileIsGatedByTargetFramework is what keeps that claim true rather than assumed;
    when it fails, this becomes a baseline per target framework.
  -->
  <PropertyGroup>
    <RunsPublicApiBaselines Condition="'$(TargetFramework)' == 'net10.0'">true</RunsPublicApiBaselines>
    <DefineConstants Condition="'$(RunsPublicApiBaselines)' == 'true'">$(DefineConstants);PUBLIC_API_BASELINES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunsPublicApiBaselines)' == 'true'">
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.DiffPlex" />
    <PackageReference Include="Verify.NUnit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared so that this suite runs under the same NUnit contract as the other two: one fixture instance
      per test case, and fixtures parallel with each other. See the file for what each decision restores.
    -->
    <Compile Include="..\Jint.Tests\TestFrameworkConventions.cs" Link="TestFrameworkConventions.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NUnit.Framework" />
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <Nullable>enable</Nullable>
    <AssemblyOriginatorKeyFile>..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jint.HtmlParser\Jint.HtmlParser.csproj" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.DiffPlex" />
    <PackageReference Include="Verify.NUnit" />
    <Compile Include="..\Jint.Tests\TestFrameworkConventions.cs" Link="TestFrameworkConventions.cs" />
    <!-- The Browser cascade is tested here without an engine: these files must build against the parser alone. -->
    <Compile Include="..\Jint.Browser\Styling\NativeCssStyleSheets.Query.cs" Link="Styling\NativeCssStyleSheets.Query.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssParsing.cs" Link="Styling\NativeCssParsing.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssQuery.cs" Link="Styling\NativeCssQuery.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssQuery.Index.cs" Link="Styling\NativeCssQuery.Index.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssQuery.Layers.cs" Link="Styling\NativeCssQuery.Layers.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssQuery.Variables.cs" Link="Styling\NativeCssQuery.Variables.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssQueryDiagnostics.cs" Link="Styling\NativeCssQueryDiagnostics.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssComputedStyle.cs" Link="Styling\NativeCssComputedStyle.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssInteractions.cs" Link="Styling\NativeCssInteractions.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssBrowserDefaults.cs" Link="Styling\NativeCssBrowserDefaults.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssSheetSets.cs" Link="Styling\NativeCssSheetSets.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssStyleSheets.cs" Link="Styling\NativeCssStyleSheets.cs" />
    <Compile Include="..\Jint.Browser\Styling\NativeCssStyleSheets.Imports.cs" Link="Styling\NativeCssStyleSheets.Imports.cs" />
    <Compile Include="..\Jint.Browser\DevTools\CssStyleSheetText.cs" Link="Styling\CssStyleSheetText.cs" />
    <Compile Include="..\Jint.Browser\Dom\DomDescendantText.cs" Link="Styling\DomDescendantText.cs" />
    <Compile Include="..\Jint.Browser\Dom\DomReadWork.cs" Link="Styling\DomReadWork.cs" />
    <Using Include="NUnit.Framework" />
    <Using Include="AwesomeAssertions" />
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>
</Project>

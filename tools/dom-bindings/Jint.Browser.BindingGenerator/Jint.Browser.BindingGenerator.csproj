<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      One target framework, and it is the LOWEST one Jint.Tests.Browser runs on rather than the newest — the
      same call tools/devtools-protocol makes and for the same reason. The staleness test runs this emitter in
      memory on every leg of that suite, so the emitter has to be loadable by the net8.0 leg; and a single
      target framework is what lets the regeneration command in tools/dom-bindings/README.md be a plain
      `dotnet run` with no framework switch.
    -->
    <TargetFramework>net8.0</TargetFramework>

    <AssemblyOriginatorKeyFile>..\..\..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <!-- So that a plain `dotnet run` with no overrides argument finds the table beside the binary. pin.json
         is deliberately NOT copied: nothing at run time reads it, and the test that checks it reads it from
         the repository, which is the only place it means anything. -->
    <None Update="overrides.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>

</Project>

  // What Schema.getDomains answers. A domain reaches this list only once it has an implemented command,
  // so a client feature-detecting through it is never told about a domain that answers nothing.
  //
  // The page-level six are deliberately absent even though they have implemented commands: this command is
  // answered by the *browser* session, which has no target in hand, and a server with no page targets would
  // otherwise claim Page to a client that would get -32601 for every command in it. No recorded client sends
  // Schema.getDomains at all; each of them feature-detects a page domain by sending one of its commands to a
  // page session, which is exactly where they are answered.
  "reportedDomains": [
    { "name": "Browser", "version": "1.3" },
    { "name": "Console", "version": "1.3" },
    { "name": "Debugger", "version": "1.3" },
    { "name": "Log", "version": "1.3" },
    { "name": "Profiler", "version": "1.3" },
    { "name": "Runtime", "version": "1.3" },
    { "name": "Schema", "version": "1.3" },
    { "name": "Target", "version": "1.3" }
  ]

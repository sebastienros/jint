{
  // What Jint.DevTools generates from, and what it claims to answer. Read tools/devtools-protocol/README.md
  // before editing: an edit here without a regeneration fails GeneratedProtocolIsCurrentTests.

  // The domains that get DTOs, a dispatch base and an event factory class. A domain listed here is
  // *generated*, which is not the same as implemented: a generated command gets a virtual whose default
  // answers -32601, and only the entries in "implementedMethods" below are overridden.
  //
  // An entry takes one of two forms. A string generates the whole domain - every command, every event,
  // every type. An object generates the commands and events it names and NOTHING ELSE, including nothing
  // for a list it leaves out; the types it gets are the closure of what those members reach, which the
  // emitter computes rather than anyone listing. A command that is not generated has no virtual and is
  // answered by the dispatch default, which is the same -32601 it answered before - so the object form
  // changes what is checked in, not what a client is told.
  //
  // Which form to use is a judgement about the domain rather than a rule: a domain whose surface is being
  // filled in stays whole, so the next command is an override and a manifest line. A domain that answers a
  // handful of commands out of dozens, and whose remainder describes machinery this engine does not have,
  // names them. See #3683: Audits cost 143 KB of DTOs for an enable and a disable that are accepted no-ops.
  "generatedDomains": [
    "Runtime",
    "Debugger",
    "Profiler",
    "Console",
    "Log",
    "Schema",
    "Target",

    // The seventeen left out are Chrome's own browser UI - window state, permissions, downloads,
    // histograms, the crash and dev-tools-visibility commands - which a hosted engine has none of.
    {
      "domain": "Browser",
      "commands": ["close", "getVersion", "getWindowForTarget", "setDownloadBehavior", "setWindowBounds"]
    },

    "Page",

    // What is left out is the emulation a compositor and a sensor stack do: virtual time, sensors, vision
    // deficiencies, media features beyond the emulated media type, and the device-posture overrides.
    {
      "domain": "Emulation",
      "commands": [
        "clearDeviceMetricsOverride", "clearGeolocationOverride", "clearIdleOverride",
        "setAutoDarkModeOverride", "setCPUThrottlingRate", "setDefaultBackgroundColorOverride",
        "setDeviceMetricsOverride", "setDocumentCookieDisabled", "setEmitTouchEventsForMouse",
        "setEmulatedMedia", "setFocusEmulationEnabled", "setGeolocationOverride",
        "setHardwareConcurrencyOverride", "setIdleOverride", "setLocaleOverride",
        "setScriptExecutionDisabled", "setScrollbarsHidden", "setTimezoneOverride",
        "setTouchEmulationEnabled", "setUserAgentOverride", "setVisibleSize"
      ]
    },

    "Network",
    "Fetch",

    // setTimeDomain is deprecated in the protocol and no recorded client sends it.
    {
      "domain": "Performance",
      "commands": ["disable", "enable", "getMetrics"]
    },

    // enable and disable are accepted no-ops because Puppeteer's page initialization fails if either
    // errors. The other half of the domain is Chrome's audit vocabulary - 67 types describing issues an
    // engine with no network stack, no cookie deprecation model and no CSP evaluator can never raise - and
    // it was 143 KB of the checked-in tree.
    {
      "domain": "Audits",
      "commands": ["disable", "enable"]
    },

    "DOM",

    // Left out: touch and drag input, synthesized scroll and pinch gestures, and the input-driver commands.
    // The flat box model dispatches a key, a mouse event and text, which is what a client uses to drive a
    // page here.
    {
      "domain": "Input",
      "commands": ["dispatchKeyEvent", "dispatchMouseEvent", "imeSetComposition", "insertText"]
    },

    "Accessibility",

    // Cookies are the whole of what a page target keeps; quota, IndexedDB, cache storage, shared storage,
    // storage buckets and interest groups are the rest of the domain and none of them exist here.
    {
      "domain": "Storage",
      "commands": ["clearCookies", "getCookies", "setCookies"]
    },

    // The two left out handle certificate errors, which this engine's fetch never raises to a client.
    {
      "domain": "Security",
      "commands": ["disable", "enable", "setIgnoreCertificateErrors"]
    },

    // Every highlight command draws into a compositor. What is answered is the pair the front end sends on
    // connect, hiding a highlight, and the paused-in-debugger message.
    {
      "domain": "Overlay",
      "commands": ["disable", "enable", "hideHighlight", "setPausedInDebuggerMessage", "setShowViewportSizeOnResize"]
    },

    // Computed and inline styles are what the flat box model can answer for. Style sheet editing, rule
    // matching, coverage, font and animation tracking are the other thirty-five commands.
    {
      "domain": "CSS",
      "commands": ["disable", "enable", "getComputedStyleForNode", "getInlineStylesForNode"]
    },

    "Jint"
  ],

  // The commands Jint.DevTools actually answers. Every entry is checked against the protocol description,
  // and ProtocolManifestTests checks each one is overridden on a registered domain - and that nothing
  // else is. An unlisted command is not a silent success; it is 'Domain.method' wasn't found.
  //
  // Target.sendMessageToTarget is deliberately absent: it is the pre-flattened session model, no client
  // recorded in tools/devtools-protocol/handshakes/ sends it, and answering it would mean a second
  // routing path kept alive forever.
  //
  // Runtime.queryObjects is absent because there is no way to enumerate the objects of a heap the CLR
  // owns. Runtime.globalLexicalScopeNames used to be absent beside it and is answered now, over the
  // engine seam that closed it: engine.Advanced.GetGlobalLexicalNames().
  // Runtime.terminateExecution is absent because a constraint is how execution is bounded here, and a
  // client that could stop a host's script at will is a different security posture.
  //
  // Profiler has no console-driven half: console.profile and console.profileEnd are not implemented by the
  // engine at all - ConsoleMethod has no member for either - so consoleProfileStarted and
  // consoleProfileFinished would be events nothing could ever raise.
  //
  // The page-level domains are a *page* target's, and Jint.Browser is what answers them: an engine target
  // has no document, so every one of them is -32601 there. That is why they are absent from reportedDomains
  // below, and why Jint.Tests.DevTools checks them through the page-level suite rather than its own.
  //
  // DOM and Input are the page half of driving a page: a client finds an element, measures it and clicks
  // where it was told the element is. Both are Jint.Browser's, over the flat box model in
  // Jint.Browser/Layout. Four are answered without being effective and each says why:
  // DOM.markUndoableState is a boundary in an undo stack that does not exist - undo and redo are
  // unimplemented - and the front end sends it around every attribute edit; DOM.getFrameOwner can only
  // ever be asked about the one frame there is, which owns nothing, so it always refuses;
  // DOM.performSearch drops Chrome's XPath arm, because AngleSharp's XPath support is a package this
  // project does not reference and no recorded client sends the command; and DOM.enable's
  // includeWhitespace is ignored, because every child node is reported either way.
  //
  // Input is dispatchMouseEvent alone. The keyboard half - dispatchKeyEvent, insertText,
  // imeSetComposition - is the next campaign item, and answering one of them now would be a silent
  // success where a client feature-detecting it wants the truth.
  // Storage is generated for three commands and no more. Every recorded client reads and writes a page's
  // cookies through Storage.getCookies and Storage.setCookies rather than through Network's, which is the
  // whole reason the domain is here; the other twenty commands name IndexedDB, cache storage, shared
  // storage, interest groups, attribution reporting and quota, and every one of those is a store this
  // browser does not have.
  //
  // The Fetch response stage is absent, and with it Fetch.continueResponse, Fetch.getResponseBody,
  // Fetch.takeResponseBodyAsStream and the whole IO domain. FetchObserver.OnResponse is a notification an
  // observer cannot answer, so a response-stage pause could only ever continue unchanged and a client that
  // called fulfillRequest from one would be silently ignored - which is worse than not pausing at all.
  // Network.getResponseBody is what answers a body here. Fetch.continueWithAuth is absent for a smaller
  // reason: nothing in this browser answers a 401 with credentials, so there is no challenge to be asked
  // about and Fetch.authRequired is never sent.
  //
  // Network's WebSocket and EventSource events are absent because the engine deliberately does not observe
  // those two handshakes (Jint/WebApi/AGENTS.md says why), and its timing document because no phase of a
  // request is measured. Network.requestServedFromCache is never sent: there is no cache.
  //
  // Emulation is effective rather than stored: the media type and the Level 5 preference features feed the
  // page's own media environment, so matchMedia answers them and a MediaQueryList whose answer moved fires
  // change; the time zone and the locale are Options fixed when an engine is built, so they take effect on
  // the next document and the command says so; touch reaches navigator.maxTouchPoints, `ontouchstart` and
  // the pointer/hover features; and geolocation, hardware concurrency and script execution are real.
  // setAutoDarkModeOverride, setIdleOverride/clearIdleOverride, setDefaultBackgroundColorOverride,
  // setCPUThrottlingRate, setScrollbarsHidden, setDocumentCookieDisabled and setEmitTouchEventsForMouse are
  // accepted no-ops: there is no renderer, no idle detector, no throttle and no scrollbar for any of them to
  // change, and every one of them is sent by a client that reads a refusal as a broken target.
  //
  // Accessibility is the tree Jint.Browser/Accessibility already computes, published in Chrome's own AXNode
  // shape with the DOM domain's backendNodeId on every node. It is what Puppeteer's page.accessibility and
  // Playwright's getByRole read. The two events - loadComplete and nodesUpdated - are deliberately absent:
  // the tree is computed per request rather than maintained, so there is nothing that could raise them
  // honestly.
  //
  // Security, Overlay and CSS are what a DevTools front end sends at a page and what the automation clients
  // never do. Each answers the handful of commands that make an ordinary attachment work and nothing else:
  // Security has no certificate state to report because the transport is HttpClient's; Overlay would draw a
  // highlight on a surface that does not exist; and CSS answers the two read commands AngleSharp.Css can
  // stand behind - the computed style of a node and its inline style - while every editing command is
  // -32601, because a style sheet this package can rewrite is a CSSOM feature nobody has asked for.
  //
  // Jint is not Chrome's. It is described in tools/devtools-protocol/jint_protocol.json, in the protocol's
  // own format and beside the two vendored files, the way Lightpanda adds its LP domain: this browser
  // renders nothing, so the three commands a client would have used a screenshot for are answered by the
  // page as text, as CommonMark and as its accessibility tree.
  "implementedMethods": [
    "Accessibility.disable",
    "Accessibility.enable",
    "Accessibility.getAXNodeAndAncestors",
    "Accessibility.getChildAXNodes",
    "Accessibility.getFullAXTree",
    "Accessibility.getPartialAXTree",
    "Accessibility.getRootAXNode",
    "Accessibility.queryAXTree",

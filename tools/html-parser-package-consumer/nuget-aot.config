<?xml version="1.0" encoding="utf-8"?>
<!-- Native AOT restore also needs compiler/runtime packs from nuget.org.
     The exact parser mapping takes precedence over the dependency wildcard. -->
<configuration>
  <packageSources>
    <clear />
    <add key="parser-local" value="../../artifacts/html-parser-package-consumer/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="parser-local">
      <package pattern="Jint.HtmlParser" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

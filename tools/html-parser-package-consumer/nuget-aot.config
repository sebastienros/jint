<?xml version="1.0" encoding="utf-8"?>
<!-- Native AOT restore also needs compiler/runtime packs from nuget.org. The parser smoke version is
     unique to the freshly packed local feed and is first restored through the local-only config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="parser-local" value="..\..\artifacts\html-parser-package-consumer\feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

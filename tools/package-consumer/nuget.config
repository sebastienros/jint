<?xml version="1.0" encoding="utf-8"?>
<!--
  Jint comes from the .nupkg this repository just produced and from nowhere else; everything Jint depends
  on comes from nuget.org, exactly as it would for a third party. The source mapping is what makes the
  first half true rather than hopeful: without it a restore could satisfy `Jint` from a cached
  5.0.0-beta from nuget.org and the whole exercise would prove nothing about the package under test.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="jint-local" value="..\..\artifacts\package\release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="jint-local">
      <package pattern="Jint" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The package's own two target frameworks. There is no net472 leg because there is no net472 asset:
         Jint.Browser is net8.0+, like Jint/WebApi/ and Jint.DevTools. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <!-- Signed with the repository key, because Jint.Browser is signed and names this assembly as a friend.
         Everything the binding has is internal, so without the grant there is nothing here to test. -->
    <AssemblyOriginatorKeyFile>..\Jint\Jint.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jint.Browser\Jint.Browser.csproj" />
    <!--
      The jint-browser command line. Tool/ runs its entry point in process rather than spawning it: an exit
      code, what went to standard output and what went to standard error are one assertion that way, the
      suite needs no published binary on disk, and a failure names a line of the tool rather than a process
      that exited with 1. Everything in that project is internal, so it names this assembly as a friend.
    -->
    <ProjectReference Include="..\Jint.Browser.Tool\Jint.Browser.Tool.csproj" />
    <!--
      The web-platform-tests corpus, its server and its exclusion vocabulary, which Wpt/ runs the browser lane
      on. One corpus and one pin: copying WptCorpus, WptServer and WptExclusion here would give the two lanes
      two of each, and nothing would say when they drifted. Jint.Tests targets net8.0/net10.0 (plus net472 on
      Windows, which this reference does not ask for) and grants InternalsVisibleTo to this assembly; the
      dependency is one way, and nothing in Jint.Tests may reference Jint.Browser.
    -->
    <ProjectReference Include="..\Jint.Tests\Jint.Tests.csproj" />
    <!--
      The emitter, referenced as a library so DomBindingsStalenessTests can run it in memory against the
      pinned assemblies and diff its output with what is checked in. That is the whole reason the generator
      targets net8.0 rather than net10.0: this suite runs on both legs, and a net10.0-only emitter would be
      unreferenceable from the lower one.
    -->
    <ProjectReference Include="..\tools\dom-bindings\Jint.Browser.BindingGenerator\Jint.Browser.BindingGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <!--
      The only client library in this suite, and the only test in it that can claim client compatibility: it
      connects to an in-process server over a real socket, opens a page and drives it. It launches nothing and
      downloads nothing. The version is the one tools/devtools-protocol/handshakes/puppeteersharp-dotnet.json
      was recorded with, so what it sends here is what that file says it sends.
    -->
    <PackageReference Include="PuppeteerSharp" />
    <!--
      The second client, and the only one whose driver is a process: Playwright for .NET is a wrapper over a
      Node program, and the package carries both it and a node runtime for the host's RID. Nothing is
      downloaded and no browser is installed, because `connectOverCDP` attaches to an endpoint that already
      exists. The driver is still a process start, an IPC handshake and a few hundred milliseconds, which is
      why DevTools/PlaywrightCourseTests runs only where JINT_BROWSER_CLIENTS says so and the `browser-clients`
      CI leg is what sets it.
    -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!--
    The public API baseline runs on one leg, the way Jint.Tests.DevTools' does and for the same reasons:
    which runtime reads a file on disk changes nothing, and a second leg is a second process reading
    artifacts/ while the first leg's build is still writing it.

    One baseline rather than one per target framework, because Jint.Browser has no conditional compilation:
    its two assets are compiled from the same sources, so their surfaces cannot differ.
    NoSourceFileIsGatedByTargetFramework is what keeps that claim true rather than assumed.
  -->
  <PropertyGroup>
    <RunsPublicApiBaselines Condition="'$(TargetFramework)' == 'net10.0'">true</RunsPublicApiBaselines>
    <DefineConstants Condition="'$(RunsPublicApiBaselines)' == 'true'">$(DefineConstants);PUBLIC_API_BASELINES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunsPublicApiBaselines)' == 'true'">
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.DiffPlex" />
    <PackageReference Include="Verify.NUnit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared so that this suite runs under the same NUnit contract as the others: one fixture instance per
      test case, and fixtures parallel with each other.
    -->
    <Compile Include="..\Jint.Tests\TestFrameworkConventions.cs" Link="TestFrameworkConventions.cs" />
    <!--
      And the switch that turns the host-contract verifiers on for a Release run, so that
      JINT_HOST_CONTRACT_VERIFICATION=1 means the same thing here as in the other suites. It has to be a
      module initializer in *this* assembly: the gate Jint reads is a static readonly bool settled at type
      initialization, and a fixture would arm it far too late. It is what makes the collection wrappers'
      obligations checked rather than asserted — every ArrayLikeObject and NamedPropertyObject hook in this
      package is verified against its siblings on every read under it.
    -->
    <Compile Include="..\Jint.Tests\HostContractVerificationSwitch.cs" Link="HostContractVerificationSwitch.cs" />
  </ItemGroup>

  <!--
    The browser lane's `resources/testharnessreport.js`, which is the slot upstream ships a stub for so that a
    vendor can replace it. WptServer takes it as a per-instance overlay, so neither Jint.Tests/Wpt/Vendor/ nor
    the engine lane's own copy in Jint.Tests/Wpt/Prelude/ changes. Its logical name is the lane's rather than
    `wpt-prelude/`: the two files answer the same URL for two different drivers.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Wpt\Prelude\*.js">
      <LogicalName>wpt-browser-prelude/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The lane's census table lives in this README, and WptBrowserCensus holds it to what the run measured. -->
    <EmbeddedResource Include="Wpt\README.md" LogicalName="wpt-browser-readme.md" />
  </ItemGroup>

  <!--
    The obstacle course: the fixture documents, their vendored libraries and the driver injected into them.
    Embedded with an explicit LogicalName for the reason the wpt corpus above is, and it matters more here:
    a fixture's own `<script src="/vendor/react-18.3.1/react.production.min.js">` is answered by looking the
    request path up in this table, so the resource key has to be the path.

    Text extensions only, and the licences, which carry no extension at all. Nothing in the course is binary:
    a fixture that needed an image would be a fixture about a rendering, and this browser has none.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\**\*.html;Fixtures\**\*.js;Fixtures\**\*.mjs;Fixtures\**\*.css;Fixtures\**\*.json;Fixtures\**\*.svelte;Fixtures\**\*.md;Fixtures\**\LICENSE">
      <LogicalName>browser-fixtures/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NUnit.Framework" />
    <Using Remove="Acornima" />
    <Using Remove="Acornima.Ast" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SelfContained>true</SelfContained>
    <JintReflectionEnabled Condition="'$(JintReflectionEnabled)' == ''">false</JintReflectionEnabled>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishAot>false</PublishAot>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Jint/Jint.csproj" />
    <RuntimeHostConfigurationOption Include="Jint.Runtime.Interop.ReflectionEnabled" Value="$(JintReflectionEnabled)" Trim="true" Condition="'$(JintReflectionEnabled)' != 'default'" />
  </ItemGroup>
</Project>
